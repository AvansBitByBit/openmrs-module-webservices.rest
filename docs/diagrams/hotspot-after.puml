@startuml
title Hotspot after - interface-driven registry facade

package "org.openmrs.module.webservices.rest.web.api" {
  interface RestService

  interface ResourceRegistry {
    +refresh()
    +getResourceByName(name)
    +getResourceBySupportedClass(type)
    +getResourceHandlers()
  }

  interface SearchHandlerRegistry {
    +refresh()
    +getSearchHandler(resource, parameters)
    +getSearchHandlers(resource)
    +getAllSearchHandlers()
  }
}

package "org.openmrs.module.webservices.rest.web.api.impl" {
  class RestServiceImpl {
    +RestServiceImpl(ResourceRegistry, SearchHandlerRegistry, ExecutorService)
    +getResourceByName(name)
    +getResourceBySupportedClass(type)
    +getResourceHandlers()
    +getSearchHandler(resource, parameters)
    +getSearchHandlers(resource)
    +initialize()
  }

  class DefaultResourceRegistry
  class DefaultSearchHandlerRegistry
}

class OpenmrsClassScanner
interface RestHelperService
interface ExecutorService

RestServiceImpl ..|> RestService
RestServiceImpl --> ResourceRegistry : constructor injection
RestServiceImpl --> SearchHandlerRegistry : constructor injection
RestServiceImpl --> ExecutorService : constructor injection
DefaultResourceRegistry ..|> ResourceRegistry
DefaultSearchHandlerRegistry ..|> SearchHandlerRegistry
DefaultResourceRegistry --> OpenmrsClassScanner
DefaultResourceRegistry --> RestHelperService
DefaultSearchHandlerRegistry --> RestHelperService

note right of RestServiceImpl
  RestService contract unchanged.
  No concrete registry construction.
end note

note bottom of ResourceRegistry
  Public Spring bean: resourceRegistry
  Replaceable extension contract.
end note

note bottom of SearchHandlerRegistry
  Public Spring bean: searchHandlerRegistry
  Replaceable extension contract.
end note
@enduml
