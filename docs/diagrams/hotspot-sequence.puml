@startuml
title Search handler lookup after refactor

actor Client
participant RestServiceImpl
participant "SearchHandlerRegistry\n(interface)" as SearchHandlerRegistry
participant DefaultSearchHandlerRegistry
participant RestHelperService

Client -> RestServiceImpl : getSearchHandler(resourceName, parameters)
RestServiceImpl -> SearchHandlerRegistry : getSearchHandler(resourceName, parameters)
SearchHandlerRegistry -> DefaultSearchHandlerRegistry : injected implementation

alt registry not initialized
  DefaultSearchHandlerRegistry -> RestHelperService : getRegisteredSearchHandlers()
  RestHelperService --> DefaultSearchHandlerRegistry : handlers
  DefaultSearchHandlerRegistry -> DefaultSearchHandlerRegistry : index by id, parameter and resource
end

DefaultSearchHandlerRegistry -> DefaultSearchHandlerRegistry : extract non-special parameters
alt s=id provided
  DefaultSearchHandlerRegistry -> DefaultSearchHandlerRegistry : lookup by resource + id
else parameter based search
  DefaultSearchHandlerRegistry -> DefaultSearchHandlerRegistry : match candidates by parameters
  DefaultSearchHandlerRegistry -> DefaultSearchHandlerRegistry : remove handlers with missing required params
  DefaultSearchHandlerRegistry -> DefaultSearchHandlerRegistry : return single/default or throw ambiguous
end

DefaultSearchHandlerRegistry --> SearchHandlerRegistry : SearchHandler or exception/null
SearchHandlerRegistry --> RestServiceImpl : SearchHandler or exception/null
RestServiceImpl --> Client : SearchHandler or exception/null
@enduml
